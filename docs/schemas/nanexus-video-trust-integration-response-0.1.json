{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanexus.ai/schemas/nanexus-video-trust-integration-response-0.1.json",
  "title": "Nanexus Video Trust integration response 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "schema_version", "request_id", "operation", "execution", "result", "evidence", "limitations"],
  "properties": {
    "document_type": {"const": "nanexus_video_trust_integration_response"},
    "schema_version": {"const": "0.1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "operation": {"type": "string", "minLength": 1, "maxLength": 32},
    "execution": {"$ref": "#/$defs/execution"},
    "result": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]
    },
    "evidence": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["source_authenticity_not_established", "depicted_event_authenticity_not_established"]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"execution": {"properties": {"status": {"const": "completed"}}}}},
      "then": {
        "properties": {
          "execution": {"properties": {"error": {"type": "null"}}},
          "result": {"$ref": "#/$defs/result"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    {
      "if": {"properties": {"execution": {"properties": {"status": {"const": "failed"}}}}},
      "then": {
        "properties": {
          "execution": {"properties": {"error": {"$ref": "#/$defs/error"}}},
          "result": {"type": "null"},
          "evidence": {"type": "null"},
          "limitations": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["malformed_request", "unsupported_contract_version", "unsupported_operation", "path_not_allowed", "input_not_found", "input_rejected", "timeout", "resource_limit", "dependency_unavailable", "transport_failure", "contract_mismatch", "internal_failure"]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": {"enum": ["completed", "failed"]},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "schema_version", "document"],
      "properties": {
        "document_type": {
          "enum": ["media_signing_verification", "media_signing_inspection", "media_signing_preservation_assessment"]
        },
        "schema_version": {"const": "0.1"},
        "document": {"type": "object"}
      }
    },
    "input_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reference", "sha256"],
      "properties": {
        "role": {
          "enum": ["input_file", "trust_anchor", "before_file", "after_file", "before_trust_anchor", "after_trust_anchor"]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_name", "core_version", "inputs"],
      "properties": {
        "core_name": {"const": "video-trust"},
        "core_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/input_reference"}
        }
      }
    }
  }
}
